@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJmb3JtX2lkIjozMywiaWF0IjoxNzU4MjcxNzg3fQ.McfOsBOw4cxP-upRF-WjKXIudtH22GpqyKKiZS5dAts
POST {{baseUrl}}/forms
Content-Type: application/json
Accept: application/json

{
    "title": "Test Form 3",
    "questions": [
        {
            "question_text": "What is your favorite pet?",
            "choices": ["Dog", "Cat", "Bird", "Other"],
            "allow_open_response": true
        },
        {
            "question_text": "What is your favorite color?",
            "choices": ["Red", "Blue", "Green", "Other"],
            "allow_open_response": true
        },
        {
            "question_text": "Do you enjoy outdoor activities?",
            "choices": ["Yes", "No", "Sometimes"],
            "allow_open_response": true
        }
    ]
}

### Submit responses
POST {{baseUrl}}/forms/33/submit
Content-Type: application/json
Accept: application/json
 
{
    "name": "Charlie Brown",
    "responses": {
        "94": "Dog",
        "95": "Blue",
        "96": "Yes"
    }
}

### Submit another response
POST {{baseUrl}}/forms/33/submit
Content-Type: application/json
Accept: application/json
 
{
    "name": "Diana Prince",
    "responses": {
        "94": "Cat",
        "95": "Red",
        "96": "No"
    }
}

### Submit another response
POST {{baseUrl}}/forms/33/submit
Content-Type: application/json
Accept: application/json
 
{
    "name": "Ethan Hunt",
    "responses": {
        "94": "Cats",
        "95": "Maroon",
        "96": "Sometimes"
    }
}

### Close the form to trigger clustering
POST {{baseUrl}}/forms/33/close
Accept: application/json
Authorization: Bearer {{token}}

### Get matches for user_id 1
GET {{baseUrl}}/forms/33/matches/20
Accept: application/json

### Get form details
GET {{baseUrl}}/forms/13
Accept: application/json
